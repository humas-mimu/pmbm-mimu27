# Dari Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_RAHASIA
# Acak minimal 32 karakter. Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter
# (Opsional) Longgarkan batas percobaan bila banyak pengguna berbagi satu IP (mis. Wi-Fi madrasah saat hari pendaftaran).
# 1 = batas standar, 3 = tiga kali lipat.
# RATE_LIMIT_MULTIPLIER=1
